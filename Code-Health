# Improved Version of the Code

```python
# bookings/rules.py

from datetime import datetime, timedelta


CANCELLATION_LIMIT_MINUTES = 10


def validate_booking(booking):
    current_time = datetime.now()

    if not booking.get("user"):
        return {"ok": False, "msg": "no user"}

    if booking.get("status") == "cancelled":
        return {"ok": False, "msg": "already cancelled"}

    if booking.get("owner") != booking.get("user"):
        return {"ok": False, "msg": "not your booking"}

    start_time = datetime.fromisoformat(booking["start"])

    if current_time + timedelta(minutes=CANCELLATION_LIMIT_MINUTES) >= start_time:
        return {"ok": False, "msg": "too late"}

    return {"ok": True}


def cancel_booking(booking, db_connection):
    validation = validate_booking(booking)

    if not validation["ok"]:
        return validation

    cursor = db_connection.cursor()

    cursor.execute(
        "UPDATE bookings SET status=? WHERE id=?",
        ("cancelled", booking["id"])
    )

    db_connection.commit()

    return {"ok": True, "msg": "cancelled"}
```

